DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/dbname
DATABASE_TEST_URL=postgresql+asyncpg://user:pass@db:5432/test_dbname
DATABASE_MIGRATION_TEST_URL=postgresql+asyncpg://user:pass@db:5432/test_migration_dbname

JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256

# Docker postgresql
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=dbname